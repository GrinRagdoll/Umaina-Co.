<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Umaina Co. — Order Receipt</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <%- include('partials/dashboardBar', { user: user, stats: stats }) %>

    <div class="container-small invoice-box">
        <a href="/webpage2" class="back no-print">&larr; Back to Listings</a>
        <div class="invoice-header">
            <h2>Umaina Co. — Official Receipt</h2>
            <p>Status: <span class="badge"><%= (product.orderStatus || 'pending').toUpperCase() %></span></p>
        </div>
        <hr>

        <div class="invoice-sections">
            <div class="section">
                <h4>Customer & Shipping Details</h4>
                <p><strong>Name:</strong> <%= product.shippingAddress?.fullName || 'N/A' %></p>
                <p><strong>Address:</strong> <%= product.shippingAddress?.addressLine || 'N/A' %></p>
                <p><strong>City / Postal:</strong> <%= product.shippingAddress?.city || '' %>, <%= product.shippingAddress?.postalCode || '' %></p>
                <p><strong>Country:</strong> <%= product.shippingAddress?.country || 'N/A' %></p>
            </div>

            <div class="section">
                <h4>Payment Info</h4>
                <p><strong>Method:</strong> <%= product.paymentMethod || 'Not specified' %></p>
                <p><strong>Payment Status:</strong> <%= (product.paymentStatus || 'unpaid').toUpperCase() %></p>
            </div>
        </div>

        <h4>Item Summary & Price Breakdown</h4>
        <table class="invoice-table">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><%= product.name %> (Winning Bid)</td>
                    <td>$<%= product.currentBid.toFixed(2) %></td>
                </tr>
                <tr>
                    <td>Shipping & Handling</td>
                    <td>$<%= (product.shippingFee || 0).toFixed(2) %></td>
                </tr>
                <tr class="total-row">
                    <td><strong>Total<%= product.paymentStatus === 'pending' ? ' Due' : ' Paid' %></strong></td>
                    <td><strong>$<%= (product.currentBid + (product.shippingFee || 0)).toFixed(2) %></strong></td>
                </tr>
            </tbody>
        </table>

        <div class="no-print action-buttons">
            <button onclick="window.print()" class="btn-secondary">Print Receipt</button>
            <br>
            <a href="/" class="btn-primary">Return Home</a>
        </div>
    </div>
</body>
</html>
